

// Это корневой файл грамматики, определяющий базовые "абстрактные" классы, объекты которых должны быть описаны конфигами отдельных языков.

enum Side {
    ANY,
    RIGHT,
    LEFT
}

class DependencyType {
    obj prop hasSideFromParent: Side;
    rel alwaysBefore(DependencyType);
    rel alwaysAfter(DependencyType);
}

class DependencyTypeUnsafe : DependencyType

class TargetWord {
    obj prop text: string;
    rel hasDependency(DependencyType) : {* -> 1};
    rel withParent(TargetWord): partial;
}