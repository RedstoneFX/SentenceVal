

obj CONJ : DependencyType {
    // Связывает элементы перечисления или корни в сложносочиненном предложении.
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от любого родителя
}

obj ROOT : DependencyType {
    // Корневая роль. Не имеет родителя, поэтому не описывает взаимное положение.
}

obj NSUBJ : DependencyType {
    // Субьект, совершающий действие в глаголе.
    hasSideFromParent = Side:LEFT; // Всегда СЛЕВА от родителя (глагола).
}

obj OBJ : DependencyType {
    // Объект, над которым совершается действие.
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя (глагола).
}

obj AUX_STATEMENT : DependencyType {
    // Вспомогательный глагол в утвердительном предложении( "I am right ." )
    hasSideFromParent = Side:LEFT; // Всегда СЛЕВА от родителя (глагола).
    alwaysAfter(NSUBJ); // Всегда СПРАВА от сиблинга с NSUBJ (субьекта).
}

obj AUX_QUESTION : DependencyType {
    // Вспомогательный глагол в вопросительном предложении( "Am I right ?" )
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя (глагола).
    alwaysBefore(NSUBJ); // Всегла СЛЕВА от сиблинга с NSUBJ (субьекта).
}

obj NMOD : DependencyTypeUnsafe {
    // Спецификатор, что-то типа прилагательного, но может быть и титулом/видом, например "Professor Higgings" или "the Chair's office".
    hasSideFromParent = Side:LEFT; // TODO: Обычно стоит слева, но есть исключения. Либо вводить новые отношения, либо разделять на подвиды.
}

obj NMOD_SPECIFICATION : DependencyType {
    // NMOD подвида или титула.
    hasSideFromParent = Side:LEFT; // TODO: Всегда находится СЛЕВА от родительского слова. Нет никакого дочернего CASE;
}

obj CASE : DependencyTypeUnsafe {
    // Союз, частица и т.п., по типу for, in, of, into.
    hasSideFromParent = Side:LEFT; // TODO: Обычно СЛЕВА от родителя, но есть исключение в виде принадлежности "'s";
}

obj CASE_POSS : DependencyType {
    // Частица принадлежности "'s".
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя.
    // TODO: Всегда вплотную к родителю.
}

obj NMOD_POSS : DependencyType {
    // NMOD принадлежности.
    // Связывает предмет с владельцем (родителем).
    hasSideFromParent = Side:LEFT; // Всегда СЛЕВА от родителя.
}

obj AMOD : DependencyTypeUnsafe {
    // Прилагательное.
    hasSideFromParent = Side:LEFT; // Обычно, СЛЕВА от родителя (существительного), но может быть и СПРАВА.
    // TODO: Исключение: There is [nothing] -amod-> [wrong]
    // TODO: Видимо, порядок относительно таких же сиблингов зависит от части речи (https://universaldependencies.org/conllu_viewer.html)
    // Грамматически, сказать "There is wrong nothing" - корректно, но так никто не говорит.
}

obj AMOD_INVERSE : DependencyType {
    // Тоже, что и AMOD, но для исключения.
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя.
}

obj DET : DependencyType {
    // THE/WHICH.
    hasSideFromParent = Side:LEFT; // Всегда СЛЕВА от родителя.
    alwaysBefore(AMOD); // Всегда слева от сиблингов вида AMOD
}

obj ACL : DependencyType {
    // "предикативное определение существительного"
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя.
    // TODO: Всегда СПРАВА от сиблингов (их много, и ничего не объяснено) https://universaldependencies.org/u/dep/acl.html
}

obj CC : DependencyType {
    // Союз.
    hasSideFromParent = Side:LEFT; // Всегда СЛЕВА от родителя.
    // TODO: Обычно, стоит вплотную к левому сиблингу родителя. Тобишь, он всегда СЛЕВА от своих сиблингов.
}

obj COMPOUND : DependencyTypeUnsafe {
    // Модульное дополнение родителю, которое должно рассматриваться как его часть.
    hasSideFromParent = Side:LEFT; // TODO: Обычно СЛЕВА от родителя, но есть исключения.
    // TODO: Обычно он в-плотную к родителю, но не всегда. https://universaldependencies.org/u/dep/compound.html
    // TODO: Тобишь, он всегда СПРАВА от своих сиблингов, но не всегда.
}

obj COMPOUND_PRT : DependencyType {
    // Почти как COMPOUND, но описывает часть устойчевых выражений или комбинированных глаголов-фраз "put up", "get on", "take of".
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя (те самые модификаторы "up", "on").
    // TODO: Всегда вплотную к родителю
}

obj PUNCT : DependencyTypeUnsafe {
    // Пунктуация.
    // TODO: Точно нельзя сказать, как она должна быть поставлена, так что нужно определить непосредственно в дереве.
}

obj PARATAXIS : DependencyTypeUnsafe {
    // Связь между отдаленными и малосвязанными словами.
    // Вообще толком ничего не определяет, ни позицию, ничего... Может стоять где угодно или зависеть от контекста/смысла.
    // Нет сиблингов между ним и родителем.
}

obj APPOS : DependencyType {
    // Уточнение.
    hasSideFromParent = Side:RIGHT; // Всегда СПРАВА от родителя.
    // Обычно, вплотную к родителю.
}